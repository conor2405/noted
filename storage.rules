rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // App Check must also be enforced for Storage in the Firebase console.
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function recordingExists(uid, recordingId) {
      return firestore.exists(
        /databases/(default)/documents/users/$(uid)/recordings/$(recordingId)
      ) && firestore.get(
        /databases/(default)/documents/users/$(uid)/recordings/$(recordingId)
      ).data.uploadState == "in_progress";
    }

    function acceptedAudio() {
      return request.resource.size > 0
        && request.resource.size <= 512 * 1024 * 1024
        && request.resource.contentType in [
          "audio/mp4",
          "audio/m4a",
          "audio/x-m4a"
        ];
    }

    match /recordings/{uid}/{recordingId}/source.m4a {
      allow create: if signedInAs(uid)
        && recordingExists(uid, recordingId)
        && acceptedAudio();
      allow update, read: if false;
      allow delete: if signedInAs(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
